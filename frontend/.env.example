VITE_USE_MOCK=true

# API Endpoints
VITE_RAG_BASE_URL=http://localhost:8000
VITE_TRADING_API_BASE_URL=http://localhost:8001
VITE_AGENT_BASE_URL=http://localhost:8003
VITE_WS_BASE_URL=ws://localhost:8002


VITE_ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
VITE_COINGECKO_API_KEY=your_coingecko_pro_api_key_here

# Application Settings
VITE_APP_NAME=Amiga Trader
VITE_APP_VERSION=2.1.0
VITE_ENVIRONMENT=development

# Theme Settings
VITE_DEFAULT_THEME=dark
VITE_ENABLE_THEME_TOGGLE=true

# Feature Flags
VITE_ENABLE_REAL_TIME_DATA=true
VITE_ENABLE_CACHING=true
VITE_ENABLE_ANALYTICS=false
VITE_DEBUG_MODE=true

# Performance Settings
VITE_MARKET_DATA_REFRESH_INTERVAL=30000
VITE_PORTFOLIO_REFRESH_INTERVAL=10000
VITE_CACHE_EXPIRY_MINUTES=5

# Security Settings
VITE_SESSION_TIMEOUT_MINUTES=60
VITE_MAX_RETRY_ATTEMPTS=3
